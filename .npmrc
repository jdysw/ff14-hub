# 注意：这里刻意不设置 registry。
# - 本地安装沿用开发者/环境已配置的 registry（例如国内镜像）。
# - CI 使用 runner 的默认 registry。
# pnpm-lock.yaml 只记录 integrity，不绑定 registry 主机，两者结果一致。
resolution-mode=highest
save-exact=true
strict-peer-dependencies=true
auto-install-peers=true
# 保持 workspace 链接使用相对路径，避免把本机绝对路径写进 lockfile/元数据。
link-workspace-packages=true
prefer-workspace-packages=true
