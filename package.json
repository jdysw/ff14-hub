{
  "name": "ff14-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FF14 Hub — FF14 工具导航 + 个人游戏信息中心 + 可自定义模块化工作台（阶段 04：自由导航、内置导航/活动模块、PWA 与跨设备同步）",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "release:production": "node scripts/ops/release-worker.mjs production",
    "release:preview": "node scripts/ops/release-worker.mjs preview",
    "generate:fishcake-script": "node scripts/build-fishcake-userscript.mjs",
    "check:fishcake-script": "node scripts/build-fishcake-userscript.mjs --check",
    "generate:android-pvp": "node --experimental-strip-types scripts/generate-android-pvp-rules.mjs",
    "check:android-pvp": "node --experimental-strip-types scripts/generate-android-pvp-rules.mjs --check",
    "e2e:navigation": "node scripts/e2e-navigation.mjs",
    "import:navigation": "node scripts/import-navigation.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types:worker": "wrangler types --include-runtime=false --strict-vars=false",
    "types:worker:check": "wrangler types --include-runtime=false --strict-vars=false --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm run build:web && pnpm run build:worker",
    "build:web": "pnpm --filter @ff14-hub/web build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env=",
    "validate:config": "wrangler deploy --dry-run --outdir .wrangler/dry-run-preview --env preview && wrangler deploy --dry-run --outdir .wrangler/dry-run-production --env production",
    "dev": "pnpm --filter @ff14-hub/web dev",
    "dev:api": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:identity": "node scripts/e2e-identity.mjs",
    "e2e:local-personal": "node scripts/e2e-local-personal.mjs",
    "ops:preflight": "node scripts/ops/preflight.mjs",
    "ops:rehearse": "node scripts/ops/rehearse.mjs",
    "test:ops": "node --test scripts/ops/ops.test.mjs scripts/ops/verify-live.test.mjs scripts/ops/snapshot-official-calendar.test.mjs scripts/ops/fish-import.test.mjs scripts/ops/fish-cn-import.test.mjs scripts/ops/fish-accuracy.test.mjs scripts/ops/fishcake-adapter.test.mjs scripts/ops/fish-intuition.test.mjs scripts/ops/release-worker.test.mjs",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "verify": "pnpm run check:fishcake-script && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:ops && pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
