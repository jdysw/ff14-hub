{
  "name": "ff14-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FF14 Hub — FF14 工具导航 + 个人游戏信息中心 + 可自定义模块化工作台（阶段 04：自由导航、内置导航/活动模块、PWA 与跨设备同步）",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types:worker": "wrangler types --include-runtime=false --strict-vars=false",
    "types:worker:check": "wrangler types --include-runtime=false --strict-vars=false --check",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "test": "pnpm -r test",
    "build": "pnpm run build:web && pnpm run build:worker",
    "build:web": "pnpm --filter @ff14-hub/web build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env=",
    "validate:config": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env preview",
    "dev": "pnpm --filter @ff14-hub/web dev",
    "dev:api": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:identity": "node scripts/e2e-identity.mjs",
    "e2e:phase02": "node scripts/e2e-phase02.mjs",
    "e2e:phase03": "node scripts/e2e-phase03.mjs",
    "e2e:phase04": "node scripts/e2e-phase04.mjs",
    "e2e:phase05": "node scripts/e2e-phase05.mjs",
    "e2e:phase05b": "node scripts/e2e-phase05b.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
