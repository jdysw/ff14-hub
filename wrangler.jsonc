{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ff14-hub",
  "account_id": "c1fc6fb71be2eaf8c73c78fd5bacaf6c",
  "workers_dev": true,
  "main": "worker/index.ts",
  // 兼容日期必须 <= 所锁定测试运行时（@cloudflare/vitest-pool-workers 0.23.0 内置
  // miniflare 5.20260815.0-alpha / workerd 1.20260815.1）支持的最大日期，
  // 否则 Workers 运行时测试会以 ERR_FUTURE_COMPATIBILITY_DATE 直接失败。
  // 升级 vitest-pool-workers 之后才可以同步上调此日期。
  "compatibility_date": "2026-08-01",

  // 前端静态资源与 API 同域（ADR-001）：
  // run_worker_first=true 让所有请求先进入 Worker，Worker 对非 /api/* 请求回退到 ASSETS，
  // 这样安全响应头（CSP 等）能统一由 Worker 施加，而不是只在 /api/* 上生效。
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // 本地开发使用的 D1 绑定。
  // database_id 是占位值：本地 (--local) 操作不会访问 Cloudflare API，
  // 也绝不会在本轮创建任何远程资源。真实远程 ID 只能由人工授权后执行 `wrangler d1 create` 获得。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ff14-hub-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    // 显式声明为 vars（带安全默认值），使 `wrangler types` 生成的绑定类型与运行时一致：
    //   ENABLE_TEST_ROUTES 默认 "0"（生产不可达自检路由）
    //   ALLOWED_ORIGINS 默认空（只允许同源写请求）
    // BOOTSTRAP_SECRET 不在此声明：它属于 secret，通过 .dev.vars 或部署 Secrets 提供。
    // 未配置时身份初始化端点会返回 503（fail-closed），因此它在运行时是**可选**的。
    "ENABLE_TEST_ROUTES": "0",
    "ALLOWED_ORIGINS": ""
  },

  // Workers Builds 分支预览仅连接测试 D1，不继承生产路由、Cron 或密钥。
  "previews": {
    "vars": {"ENVIRONMENT": "preview", "ENABLE_TEST_ROUTES": "0", "ALLOWED_ORIGINS": ""},
    "d1_databases": [{"binding": "DB", "database_name": "ff14-hub-preview", "database_id": "dc1e8d15-74ea-42a5-9090-b553002cce28", "migrations_dir": "migrations"}]
  },

  // 预览与生产环境分离：各自持有独立的 D1 与 ENVIRONMENT。
  // main / assets / compatibility_date 沿用顶层；vars 和 bindings 不继承，必须逐环境声明。
  // 占位 ID 会被发布预检拒绝；真实 ID 与 Secrets 必须在发布准备时分别配置。
  "env": {
    "preview": {
      "name": "ff14-hub-preview",
      "routes": [{ "pattern": "ff14-preview.zhixia.uk", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "preview",
        "ENABLE_TEST_ROUTES": "0",
        "ALLOWED_ORIGINS": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ff14-hub-preview",
          "database_id": "dc1e8d15-74ea-42a5-9090-b553002cce28",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "ff14-hub",
      "triggers": {"crons": ["*/5 * * * *"]},
      "routes": [{ "pattern": "ff14.zhixia.uk", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "ENABLE_TEST_ROUTES": "0",
        "ALLOWED_ORIGINS": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ff14-hub-production",
          "database_id": "8293ac2b-5245-4788-9756-6225330a3526",
          "migrations_dir": "migrations"
        }
      ]
    }
  },

  // 默认不调度；只有 production 显式启用每 5 分钟的轻量每日汇总队列。
  "triggers": {
    "crons": []
  }
}
