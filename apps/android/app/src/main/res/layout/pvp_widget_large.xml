<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="14dp" android:background="@drawable/pvp_widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
  <TextView android:id="@+id/pvp_heading" style="@style/PvpHeading" android:text="PVP 战场" android:layout_width="0dp" android:layout_weight="1"/>
  <TextView android:id="@+id/pvp_status" style="@style/PvpLabel" android:layout_width="wrap_content" android:textSize="10sp" android:maxLines="1"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <include layout="@layout/pvp_front_column"/>
  <LinearLayout android:layout_width="20dp" android:layout_height="1dp" android:orientation="vertical"/>
  <include layout="@layout/pvp_crystal_column"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/pvp_schedule_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
  <TextView style="@style/PvpLabel" android:text="接下来三轮"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/pvp_front_slot_1_time" style="@style/PvpScheduleTime"/>
    <TextView android:id="@+id/pvp_front_slot_1_map" style="@style/PvpScheduleMap"/>
    <TextView android:id="@+id/pvp_front_slot_2_time" style="@style/PvpScheduleTime"/>
    <TextView android:id="@+id/pvp_front_slot_2_map" style="@style/PvpScheduleMap"/>
    <TextView android:id="@+id/pvp_front_slot_3_time" style="@style/PvpScheduleTime"/>
    <TextView android:id="@+id/pvp_front_slot_3_map" style="@style/PvpScheduleMap"/>
   </LinearLayout>
   <LinearLayout android:layout_width="20dp" android:layout_height="1dp" android:orientation="vertical"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/pvp_crystal_slot_1_time" style="@style/PvpScheduleTime"/>
    <TextView android:id="@+id/pvp_crystal_slot_1_map" style="@style/PvpScheduleMap"/>
    <TextView android:id="@+id/pvp_crystal_slot_2_time" style="@style/PvpScheduleTime"/>
    <TextView android:id="@+id/pvp_crystal_slot_2_map" style="@style/PvpScheduleMap"/>
    <TextView android:id="@+id/pvp_crystal_slot_3_time" style="@style/PvpScheduleTime"/>
    <TextView android:id="@+id/pvp_crystal_slot_3_map" style="@style/PvpScheduleMap"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
