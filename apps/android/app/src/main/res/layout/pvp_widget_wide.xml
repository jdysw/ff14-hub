<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/pvp_widget_solid" android:foreground="@drawable/pvp_widget_feedback">
 <ImageView android:id="@+id/pvp_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pvp_widget_solid" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
 <LinearLayout android:id="@+id/pvp_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
  <TextView android:id="@+id/pvp_heading" style="@style/PvpHeading" android:text="" android:visibility="gone" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
   <include layout="@layout/pvp_front_column" />
   <LinearLayout android:layout_width="12dp" android:layout_height="1dp" android:orientation="vertical" />
   <include layout="@layout/pvp_crystal_column" />
  </LinearLayout>
  <TextView android:id="@+id/pvp_status" style="@style/PvpLabel" android:layout_marginTop="8dp" android:maxLines="1" android:visibility="gone" android:text="" />
 </LinearLayout>
</FrameLayout>