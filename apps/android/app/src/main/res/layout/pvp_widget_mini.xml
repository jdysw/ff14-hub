<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/pvp_widget_solid" android:foreground="@drawable/pvp_widget_feedback">
 <ImageView android:id="@+id/pvp_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pvp_widget_solid" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null"/>
 <LinearLayout android:id="@+id/pvp_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp" android:gravity="center_vertical">
  <TextView android:id="@+id/pvp_heading" style="@style/PvpHeading" android:visibility="gone"/>
  <TextView android:id="@+id/pvp_front_label" style="@style/PvpLabel" android:visibility="gone"/>
  <TextView android:id="@+id/pvp_front_current" style="@style/PvpMap" android:textSize="12sp" android:maxLines="1" android:layout_marginTop="0dp"/>
  <TextView android:id="@+id/pvp_crystal_label" style="@style/PvpLabel" android:visibility="gone"/>
  <TextView android:id="@+id/pvp_crystal_current" style="@style/PvpMap" android:textSize="12sp" android:maxLines="1" android:layout_marginTop="4dp"/>
  <TextView android:id="@+id/pvp_status" style="@style/PvpLabel" android:visibility="gone"/>
 </LinearLayout>
</FrameLayout>
