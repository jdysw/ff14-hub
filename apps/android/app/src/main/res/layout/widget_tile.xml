<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/widget_bg" android:padding="14dp" android:orientation="vertical">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:textColor="#4A6787" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
 <TextView android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="7dp" android:textColor="#263B54" android:textSize="17sp" android:textStyle="bold"
  android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="5dp" android:textColor="#526A85" android:textSize="12sp"
  android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_tertiary" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="3dp" android:textColor="#72849B" android:textSize="11sp"
  android:maxLines="2" android:ellipsize="end"/>
 <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:layout_marginTop="5dp" android:textColor="#315F91" android:textSize="13sp" android:visibility="gone"/>
</LinearLayout>
